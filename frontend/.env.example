# Base URL of the Express backend. next.config.mjs rewrites /api/:path* to
# this origin (same-origin requests from the browser). Defaults to
# http://localhost:5000 when unset (backend PORT in backend/.env).
API_BASE_URL=http://localhost:5000

# Set before BUILD and start on a custom preview/staging host to prevent indexing.
# VERCEL_ENV is detected automatically unless SEO_ENV overrides it.
# Leave unset for ordinary production builds; next dev defaults to noindex.
# SEO_ENV=preview

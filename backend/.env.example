NODE_ENV=development
PORT=5000

# Neon PostgreSQL (or any Postgres). DATABASE_URL carries runtime traffic and
# should be the -pooler endpoint. DIRECT_URL is used for migrations and seeds.
#
# connect_timeout matters more than it looks. Neon suspends the compute after a
# few idle minutes, and the first query after a wake fails with "Can't reach
# database server" unless the driver waits the compute out. A cold start
# measured 3.1s here, and the default timeout lost that race.
DATABASE_URL="postgresql://user:password@host-pooler.example.com/db?sslmode=require&connect_timeout=30"
DIRECT_URL="postgresql://user:password@host.example.com/db?sslmode=require&connect_timeout=30"

# Frontend origin for CORS
FRONTEND_ORIGIN=http://localhost:3000

# Auth
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=7d
AUTH_COOKIE_NAME=admin_session
COOKIE_SECURE=false

# Email (smtp or resend)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Your Brand <info@example.com>"
EMAIL_PROVIDER=smtp
RESEND_API_KEY=
ADMIN_EMAIL=info@example.com
ADMIN_PASSWORD=
EMAIL_ENABLED=false

# File uploads
UPLOAD_ROOT=.
PUBLIC_FILE_BASE_URL=
MAX_UPLOAD_MB=4

# Storage (local | database; database is inferred on Vercel)
STORAGE_DRIVER=local

# AI assistant
#
# Groq is the default: every reply is grounded in the catalog, so the job is
# instruction following rather than knowledge, and it streams a 70B model at a
# few hundred tokens a second. Swap ASSISTANT_PROVIDER and nothing else changes.
#
#   groq     ASSISTANT_MODEL=openai/gpt-oss-120b
#   gemini   ASSISTANT_MODEL=gemini-flash-latest
#   openai   ASSISTANT_MODEL=gpt-4o-mini
#
# Provider: openai | gemini | groq
ASSISTANT_ENABLED=false
ASSISTANT_PROVIDER=groq

# Only the key for the selected provider is needed.
GROQ_API_KEY=
GEMINI_API_KEY=
OPENAI_API_KEY=

# Groq serves the OpenAI chat completions shape, so it reuses the same client
# with a different base URL.
GROQ_BASE_URL=https://api.groq.com/openai/v1

# Must be a model your account can actually call. Provider docs list a global
# lineup, but access is granted per account; run `pnpm assistant:check` after
# changing this and it lists what your key can reach.
ASSISTANT_MODEL=openai/gpt-oss-120b
# Secondary model used when the primary keeps failing transiently. Same provider
# reuses the one key.
ASSISTANT_FALLBACK_MODEL=openai/gpt-oss-20b
# Attempts before giving up on a model, with exponential backoff between them.
ASSISTANT_MAX_ATTEMPTS=3
ASSISTANT_RETRY_BASE_MS=500
# Conversation caps
ASSISTANT_MAX_MESSAGES=30
ASSISTANT_MAX_SESSION_TOKENS=50000
ASSISTANT_MAX_OUTPUT_TOKENS=600
ASSISTANT_MAX_HISTORY_MESSAGES=10
ASSISTANT_MAX_CONTEXT_CHARS=40000
ASSISTANT_MAX_DAILY_TOKENS=200000
# Streaming
ASSISTANT_STREAM=true
# Must stay below the frontend abort (150s) so the server can send a clean
# error frame instead of leaving the client to time out mid-answer.
ASSISTANT_STREAM_TIMEOUT_MS=120000
# Context cache TTL (ms)
ASSISTANT_CONTEXT_TTL_MS=300000
# IP hashing salt for usage tracking (falls back to JWT_SECRET)
ASSISTANT_IP_HASH_SALT=
